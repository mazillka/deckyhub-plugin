#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Install DeckyHub
Comment=Installs DeckyHub, and Decky Loader first if it isn't installed
Exec=sh -c 'rm -f /tmp/install-deckyhub.sh; if curl -fsSL --connect-timeout 60 -o /tmp/install-deckyhub.sh https://github.com/mazillka/deckyhub-plugin/releases/download/@TAG@/install-deckyhub.sh; then bash /tmp/install-deckyhub.sh; else echo "Could not download the DeckyHub installer. Check that the Deck is online, then try again."; read; fi'
Icon=steamdeck-gaming-return
Terminal=true
Type=Application
StartupNotify=false
