{
  "name": "deckyhub",
  "version": "3.4.0-rc.14",
  "description": "Discover, track, and safely download GitHub releases for Decky plugins from Gaming Mode.",
  "author": "Andrii Shevchuk-Yuhanets",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test:backend": "python -m unittest discover -s tests",
    "test:frontend": "node --test tests/version.test.ts tests/i18n.test.ts tests/independentAudit.test.ts tests/rawCache.test.ts tests/notes.test.ts tests/remote-install.test.js tests/remoteTrusted.test.ts",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"devtools/**/*.{ts,tsx,mjs}\" \"*.mjs\" && ruff format --check && ruff check",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"devtools/**/*.{ts,tsx,mjs}\" \"*.mjs\" && ruff format && ruff check --fix"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "2.0.4",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "rollup": "^4.67.5",
    "typescript": "^7.0.2"
  }
}
